+
+# TASK-0100: `--dry-run` prints this plan after parsing and validation and
+# exits before mktemp, curl, or any copy, so nothing is downloaded, written,
+# or installed. Prefixing actions with "would" matches trellium.py's dry-run
+# output convention.
+print_plan() {
+  if [ -n "$SOURCE_DIR" ]; then
+    version_desc="local source (no --version required)"
+    origin="local source $SOURCE_DIR"
+  else
+    version_desc="$VERSION"
+    origin="download $REPO tag $VERSION"
+  fi
+  if [ "$PROJECT" -eq 1 ]; then
+    dest="$PWD/.claude/skills"
+  elif [ -n "$TARGET_DIR" ]; then
+    dest="$TARGET_DIR"
+  else
+    case "${AGENT:-$(detect_agent)}" in
+      codex) dest="$(codex_skills_dir)" ;;
+      claude) dest="$(claude_skills_dir)" ;;
+      all) dest="$(codex_skills_dir), $(claude_skills_dir)" ;;
+      *) dest="(unresolved: a real run exits before installing)" ;;
+    esac
+  fi
+  printf 'plan: version=%s\n' "$version_desc"
+  printf 'plan: package=%s\n' "$PACKAGE"
+  printf 'plan: would fetch from %s\n' "$origin"
+  printf 'plan: would install %s into %s\n' "$PACKAGE" "$dest"
+}
+
 # Removed (TASK-0024): latest-release resolution is not supported. Network
 # installs require an explicit --version tag and fail closed without one.
+# The check runs before mktemp/curl so a versionless network install exits
+# identically with or without --dry-run (TASK-0100).
+if [ -z "$SOURCE_DIR" ] && [ -z "$VERSION" ]; then
+  echo "error: network installs require an explicit --version TAG (for example: --version 2026.09.10)" >&2
+  echo "       latest-release resolution is not supported; pick a tag from the repository's tagged releases," >&2
+  echo "       or use --source <dir> to install from a local checkout without a version." >&2
+  exit 1
+fi
+
+if [ "$DRY_RUN" -eq 1 ]; then
+  print_plan
+  exit 0
+fi
 
 TEMP_ROOT=$(mktemp -d) || exit 1
 trap 'rm -rf "$TEMP_ROOT"' EXIT INT TERM
