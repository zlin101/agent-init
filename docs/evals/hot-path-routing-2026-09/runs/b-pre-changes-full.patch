+codex_skills_dir() { printf '%s/skills' "${CODEX_HOME:-$HOME/.codex}"; }
+claude_skills_dir() { printf '%s/skills' "$HOME/.claude"; }
+
+detect_agent() {
+  if [ -n "${CODEX_HOME:-}" ] || [ -d "$HOME/.codex" ]; then
+    echo "codex"
+    return 0
+  fi
+  if [ -d "$HOME/.claude" ]; then
