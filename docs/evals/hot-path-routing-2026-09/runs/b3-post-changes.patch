@@ -19,6 +19,22 @@ class InstallScriptTest(unittest.TestCase):
     def tearDown(self) -> None:
         self.temporary_directory.cleanup()
 
+    def recording_curl_environment(self) -> tuple[dict[str, str], Path]:
+        """Build an environment whose curl only records its arguments."""
+        fake_bin = self.root / "bin"
+        fake_bin.mkdir()
+        call_log = self.root / "curl-calls.log"
+        curl = fake_bin / "curl"
+        curl.write_text(
+            "#!/bin/sh\nprintf '%s\\n' \"$*\" >> \"$CURL_CALL_LOG\"\n",
+            encoding="utf-8",
+        )
+        curl.chmod(0o755)
+        environment = dict(os.environ)
+        environment["PATH"] = f"{fake_bin}{os.pathsep}{environment['PATH']}"
+        environment["CURL_CALL_LOG"] = str(call_log)
+        return environment, call_log
+
     def run_installer(self, *arguments: str, cwd: Path | None = None, home: Path | None = None) -> subprocess.CompletedProcess:
         environment = dict(os.environ)
         environment.pop("CODEX_HOME", None)
@@ -90,14 +106,7 @@ class InstallScriptTest(unittest.TestCase):
         # latest-release resolution was removed, and the failure must happen
         # before any network access. A recording fake curl on PATH proves no
         # network tool is invoked at all.
-        fake_bin = self.root / "bin"
-        fake_bin.mkdir()
-        call_log = self.root / "curl-calls.log"
-        (fake_bin / "curl").write_text(
-            "#!/bin/sh\nprintf '%s\\n' \"$*\" >> \"$CURL_CALL_LOG\"\n",
-            encoding="utf-8",
-        )
-        (fake_bin / "curl").chmod(0o755)
+        environment, call_log = self.recording_curl_environment()
 
         result = subprocess.run(
             ["sh", str(INSTALL_SCRIPT)],
@@ -105,11 +114,67 @@ class InstallScriptTest(unittest.TestCase):
             capture_output=True,
             text=True,
             check=False,
-            env={
-                **os.environ,
-                "PATH": f"{fake_bin}{os.pathsep}{os.environ['PATH']}",
-                "CURL_CALL_LOG": str(call_log),
-            },
+            env=environment,
+        )
+        self.assertEqual(result.returncode, 1)
+        self.assertIn("--version", result.stderr)
+        self.assertFalse(call_log.exists(), "curl must not be invoked before the version check")
+
+    def test_dry_run_flag_toggles_plan_vs_install(self) -> None:
+        # TASK-0100: --dry-run prints the plan after parsing and exits before
+        # mktemp/cp (zero execution); the same command without the flag takes
+        # the normal install branch.
+        target = self.root / "skills"
+
+        dry_run = self.run_installer("--dir", str(target), "--dry-run")
+        self.assertEqual(dry_run.returncode, 0, dry_run.stderr)
+        self.assertIn("plan:", dry_run.stdout)
+        self.assertIn(str(target), dry_run.stdout)
+        self.assertFalse(target.exists(), "dry-run must not create the target")
+
+        result = self.run_installer("--dir", str(target))
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertNotIn("plan:", result.stdout)
+        self.assertTrue((target / "trellium" / "SKILL.md").is_file())
+
+    def test_dry_run_network_plan_never_touches_network(self) -> None:
+        # TASK-0100: a versioned network plan is printed while the recording
+        # fake curl stays untouched, proving no network path is reached.
+        environment, call_log = self.recording_curl_environment()
+
+        result = subprocess.run(
+            [
+                "sh",
+                str(INSTALL_SCRIPT),
+                "--dry-run",
+                "--version",
+                "2026.09.10",
+                "--dir",
+                str(self.root / "skills"),
+            ],
+            cwd=self.root,
+            capture_output=True,
+            text=True,
+            check=False,
+            env=environment,
+        )
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertIn("plan:", result.stdout)
+        self.assertFalse((self.root / "skills").exists(), "dry-run must not create the target")
+        self.assertFalse(call_log.exists(), "curl must not be invoked in dry-run")
+
+    def test_dry_run_still_fails_closed_without_version(self) -> None:
+        # TASK-0100 AC: --dry-run must not weaken the TASK-0024 gate; a
+        # versionless network request fails closed before any side effect.
+        environment, call_log = self.recording_curl_environment()
+
+        result = subprocess.run(
+            ["sh", str(INSTALL_SCRIPT), "--dry-run"],
+            cwd=self.root,
+            capture_output=True,
+            text=True,
+            check=False,
+            env=environment,
         )
         self.assertEqual(result.returncode, 1)
         self.assertIn("--version", result.stderr)
