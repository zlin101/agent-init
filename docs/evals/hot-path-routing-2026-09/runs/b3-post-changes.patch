 #
 # Defaults: --lang en; agent auto-detected ($CODEX_HOME or ~/.codex -> codex,
 # then ~/.claude -> claude); network installs require an explicit --version
@@ -27,11 +28,12 @@ VERSION=""
 TARGET_DIR=""
 PROJECT=0
 SOURCE_DIR=""
+DRY_RUN=0
 
 usage() {
   cat <<'EOF'
 usage: install.sh [--lang en|zh] [--agent codex|claude|all] [--version TAG]
-                  [--dir PATH] [--project] [--source DIR]
+                  [--dir PATH] [--project] [--source DIR] [--dry-run]
 
   --lang      package language: en (default) or zh
   --agent     skills directory owner: codex, claude, or all
@@ -41,6 +43,7 @@ usage: install.sh [--lang en|zh] [--agent codex|claude|all] [--version TAG]
   --dir       explicit destination skills directory
   --project   install into ./.claude/skills of the current directory
   --source    install from a local checkout/release tree instead of downloading
+  --dry-run   print the planned actions after parsing; no network, no writes
 EOF
   exit 2
 }
@@ -53,6 +56,7 @@ while [ $# -gt 0 ]; do
     --dir) [ $# -ge 2 ] || usage; TARGET_DIR=$2; shift 2 ;;
     --project) PROJECT=1; shift ;;
     --source) [ $# -ge 2 ] || usage; SOURCE_DIR=$2; shift 2 ;;
+    --dry-run) DRY_RUN=1; shift ;;
     -h|--help) usage ;;
     *) echo "error: unknown option: $1" >&2; usage ;;
   esac
@@ -65,7 +69,43 @@ case "$LANG_OPT" in
 esac
 
 # Removed (TASK-0024): latest-release resolution is not supported. Network
-# installs require an explicit --version tag and fail closed without one.
+# installs require an explicit --version tag and fail closed without one. The
+# gate runs before mktemp and before the --dry-run exit, so a dry-run request
+# can never bypass it (TASK-0100).
+if [ -z "$SOURCE_DIR" ] && [ -z "$VERSION" ]; then
+  echo "error: network installs require an explicit --version TAG (for example: --version 2026.09.10)" >&2
+  echo "       latest-release resolution is not supported; pick a tag from the repository's tagged releases," >&2
+  echo "       or use --source <dir> to install from a local checkout without a version." >&2
+  exit 1
+fi
+
+# TASK-0100: dry-run plan. Printed after parsing and validation, before
+# mktemp/curl/cp: it only describes the actions, so a dry run performs no
+# network access and writes no files.
+print_plan() {
+  printf 'plan: lang=%s package=%s\n' "$LANG_OPT" "$PACKAGE"
+  if [ -n "$SOURCE_DIR" ]; then
+    printf 'plan: source=%s (local tree)\n' "$SOURCE_DIR"
+  else
+    printf 'plan: source=%s tag=%s\n' "$REPO" "$VERSION"
+  fi
+  if [ "$PROJECT" -eq 1 ]; then
+    printf 'plan: target=%s/.claude/skills\n' "$PWD"
+  elif [ -n "$TARGET_DIR" ]; then
+    printf 'plan: target=%s\n' "$TARGET_DIR"
+  elif [ -n "$AGENT" ]; then
+    printf 'plan: target=agent:%s\n' "$AGENT"
+  else
+    printf 'plan: target=auto-detect (codex|claude)\n'
+  fi
+  printf 'plan: action=replace %s in the target skills directory\n' "$PACKAGE"
+  printf 'plan: side-effects=none (dry run)\n'
+}
+
+if [ "$DRY_RUN" -eq 1 ]; then
+  print_plan
+  exit 0
+fi
 
 TEMP_ROOT=$(mktemp -d) || exit 1
 trap 'rm -rf "$TEMP_ROOT"' EXIT INT TERM
