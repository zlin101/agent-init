diff --git a/tests/test_books.py b/tests/test_books.py
new file mode 100644
index 0000000..70d2ba2
--- /dev/null
+++ b/tests/test_books.py
@@ -0,0 +1,62 @@
+# pyright: reportMissingImports=false
+"""Tests for the paginated /books endpoint of the catalog API."""
+
+import asyncio
+
+import httpx
+
+from app.main import app
+
+
+def _get(url: str, params: dict[str, int] | None = None) -> httpx.Response:
+    """Send a GET request through the ASGI app without opening a real port."""
+
+    async def run() -> httpx.Response:
+        transport = httpx.ASGITransport(app=app)
+        async with httpx.AsyncClient(transport=transport, base_url="http://test") as client:
+            return await client.get(url, params=params)
+
+    return asyncio.run(run())
+
+
+def test_list_books_defaults():
+    """Default paging returns the whole seed catalog with envelope metadata."""
+    resp = _get("/books")
+    assert resp.status_code == 200
+    body = resp.json()
+    assert body["page"] == 1
+    assert body["page_size"] == 20
+    assert body["total"] == 6
+    assert len(body["items"]) == 6
+    assert body["items"][0] == {"id": 1, "title": "The Left Hand of Darkness", "author": "Ursula Le Guin"}
+
+
+def test_list_books_second_page():
+    """page=2 with page_size=2 returns the third and fourth book."""
+    resp = _get("/books", params={"page": 2, "page_size": 2})
+    assert resp.status_code == 200
+    body = resp.json()
+    assert body["page"] == 2
+    assert body["page_size"] == 2
+    assert [item["id"] for item in body["items"]] == [3, 4]
+
+
+def test_list_books_page_past_end_is_empty():
+    """A page beyond the catalog is empty while total stays accurate."""
+    resp = _get("/books", params={"page": 99})
+    assert resp.status_code == 200
+    body = resp.json()
+    assert body["items"] == []
+    assert body["total"] == 6
+
+
+def test_list_books_rejects_page_size_above_limit():
+    """page_size above the documented upper bound of 100 is rejected."""
+    resp = _get("/books", params={"page_size": 101})
+    assert resp.status_code == 422
+
+
+def test_list_books_rejects_page_below_one():
+    """page must start at 1, so 0 is rejected as invalid input."""
+    resp = _get("/books", params={"page": 0})
+    assert resp.status_code == 422
