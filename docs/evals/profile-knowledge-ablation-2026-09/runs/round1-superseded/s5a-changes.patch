--- /dev/null
+++ b/app/services.py
@@ -0,0 +1,43 @@
+# pyright: reportMissingImports=false
+"""In-memory book catalog service backing the ``GET /books`` endpoint.
+
+The catalog is a static, read-only seed dataset: there is no database or
+external system behind it, so this layer only slices the seed into pages
+instead of going through a repository.
+"""
+
+from app.schemas import Book
+
+# Seed data for the catalog. It is read-only at runtime (handlers only slice
+# the tuple), so it is safe to keep as a module-level constant.
+_BOOKS: tuple[Book, ...] = (
+    Book(id=1, title="The Left Hand of Darkness", author="Ursula Le Guin"),
+    Book(id=2, title="Kindred", author="Octavia Butler"),
+    Book(id=3, title="The Dispossessed", author="Ursula Le Guin"),
+    Book(id=4, title="Parable of the Sower", author="Octavia Butler"),
+    Book(id=5, title="Neuromancer", author="William Gibson"),
+    Book(id=6, title="Snow Crash", author="Neal Stephenson"),
+)
+
+
+def get_books(page: int, page_size: int) -> tuple[list[Book], int]:
+    """Return one page of the catalog together with the total book count.
+
+    Pagination is 1-based: page 1 starts at index 0 of the seed data. A page
+    past the end of the catalog yields an empty item list while the returned
+    total still reflects the full catalog size.
+
+    Args:
+        page: 1-based page number to fetch; must be >= 1 (validated by the
+            API layer before this function is called).
+        page_size: Maximum number of books on the page; must be between 1
+            and 100 (validated by the API layer before this function is called).
+
+    Returns:
+        A tuple of (books on the requested page, total number of books).
+    """
+    total = len(_BOOKS)
+    # Translate the 1-based page number into a slice over the seed tuple.
+    start = (page - 1) * page_size
+    end = start + page_size
+    return list(_BOOKS[start:end]), total
