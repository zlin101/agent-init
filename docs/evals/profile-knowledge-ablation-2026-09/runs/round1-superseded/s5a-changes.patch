--- /dev/null
+++ b/app/schemas.py
@@ -0,0 +1,34 @@
+# pyright: reportMissingImports=false
+"""Pydantic data models for the catalog API responses."""
+
+from typing import Generic, TypeVar
+
+from pydantic import BaseModel, Field
+
+# Element type of the paginated envelope; each list endpoint parameterizes it
+# with its own row model (e.g. PaginatedResponse[Book]).
+T = TypeVar("T")
+
+
+class PaginatedResponse(BaseModel, Generic[T]):
+    """Common paginated envelope returned by list endpoints.
+
+    Attributes:
+        items: Rows belonging to the requested page.
+        total: Total number of rows across all pages.
+        page: The requested 1-based page number.
+        page_size: The requested maximum number of rows per page.
+    """
+
+    items: list[T] = Field(..., description="Rows on the requested page")
+    total: int = Field(..., description="Total row count across all pages", examples=[6])
+    page: int = Field(..., description="Requested 1-based page number", examples=[1])
+    page_size: int = Field(..., description="Requested rows per page", examples=[20])
+
+
+class Book(BaseModel):
+    """A single book in the catalog."""
+
+    id: int = Field(..., description="Stable identifier of the book", examples=[1])
+    title: str = Field(..., description="Title of the book", examples=["The Left Hand of Darkness"])
+    author: str = Field(..., description="Author of the book", examples=["Ursula Le Guin"])
diff --git a/app/services.py b/app/services.py
