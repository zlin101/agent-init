@@ -0,0 +1,35 @@
+# pyright: reportMissingImports=false
+"""Pydantic response models shared by the catalog API.
+
+Pagination envelopes live here so every paginated endpoint returns the
+same public structure instead of redefining its own.
+"""
+
+from typing import Generic, TypeVar
+
+from pydantic import BaseModel, Field
+
+# Element type of a page: each endpoint specializes Page with its own item model.
+T = TypeVar("T")
+
+
+class Book(BaseModel):
+    """A single book in the catalog."""
+
+    id: int = Field(..., description="Unique book identifier.", examples=[1])
+    title: str = Field(..., description="Book title.", examples=["The Left Hand of Darkness"])
+    author: str = Field(..., description="Book author.", examples=["Ursula Le Guin"])
+
+
+class Page(BaseModel, Generic[T]):
+    """Paginated response envelope shared by list endpoints.
+
+    ``page`` and ``page_size`` echo the effective pagination request so
+    clients can render paging controls without guessing.
+    """
+
+    items: list[T] = Field(..., description="Records on the current page.")
+    page: int = Field(..., description="1-based index of the current page.", examples=[1])
+    page_size: int = Field(..., description="Maximum number of records per page.", examples=[20])
+    total: int = Field(..., description="Total number of records across all pages.", examples=[5])
+    pages: int = Field(..., description="Total number of pages given page_size.", examples=[1])
