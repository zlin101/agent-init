@@ -0,0 +1,62 @@
+# pyright: reportMissingImports=false
+"""Tests for the GET /books endpoint."""
+
+import asyncio
+
+import httpx
+
+from app.main import app
+
+
+def _get(url: str, params: dict | None = None) -> httpx.Response:
+    """Issue a GET request against the ASGI app without binding a port."""
+
+    async def run():
+        transport = httpx.ASGITransport(app=app)
+        async with httpx.AsyncClient(transport=transport, base_url="http://test") as client:
+            return await client.get(url, params=params)
+
+    return asyncio.run(run())
+
+
+def test_list_books_defaults():
+    resp = _get("/books")
+    assert resp.status_code == 200
+    body = resp.json()
+    # Defaults: page=1, page_size=20; the whole catalog fits on one page.
+    assert body["page"] == 1
+    assert body["page_size"] == 20
+    assert body["total"] == 5
+    assert body["pages"] == 1
+    assert len(body["items"]) == 5
+    assert body["items"][0] == {"id": 1, "title": "The Left Hand of Darkness", "author": "Ursula Le Guin"}
+
+
+def test_list_books_pagination_slice():
+    resp = _get("/books", params={"page": 2, "page_size": 2})
+    assert resp.status_code == 200
+    body = resp.json()
+    assert body["page"] == 2
+    assert body["page_size"] == 2
+    assert body["total"] == 5
+    assert body["pages"] == 3
+    assert [b["id"] for b in body["items"]] == [3, 4]
+
+
+def test_list_books_beyond_last_page_is_empty():
+    resp = _get("/books", params={"page": 99, "page_size": 20})
+    assert resp.status_code == 200
+    body = resp.json()
+    assert body["items"] == []
+    assert body["total"] == 5
+
+
+def test_list_books_page_size_capped_at_100():
+    assert _get("/books", params={"page_size": 100}).status_code == 200
+    resp = _get("/books", params={"page_size": 101})
+    assert resp.status_code == 422
+
+
+def test_list_books_page_must_be_positive():
+    resp = _get("/books", params={"page": 0})
+    assert resp.status_code == 422
