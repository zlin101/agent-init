+@app.get("/books", response_model=Page[Book])
+def list_books(
+    page: int = Query(1, ge=1, description="1-based page number to return.", examples=[1]),
+    page_size: int = Query(
+        20,
+        ge=1,
+        le=100,
+        description="Number of books per page; capped at 100.",
+        examples=[20],
+    ),
+) -> Page[Book]:
+    """Return a paginated page of books.
+
+    ``page`` defaults to 1 and ``page_size`` defaults to 20 (max 100);
+    out-of-range values are rejected by query validation before this
+    handler runs.
+    """
+    # Slice the in-memory catalog: offset-based pagination over the fixed list.
+    total = len(BOOKS)
+    start = (page - 1) * page_size
+    end = start + page_size
+    items = BOOKS[start:end]
+    pages = (total + page_size - 1) // page_size if total else 0
+    return Page(items=items, page=page, page_size=page_size, total=total, pages=pages)
