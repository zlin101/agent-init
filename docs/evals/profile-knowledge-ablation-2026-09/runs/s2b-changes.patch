+"""库存查询服务入口：GET /items 返回内存中库存列表的 JSON。"""
+
+from collections.abc import AsyncIterator
+from contextlib import asynccontextmanager
+
+from fastapi import Depends, FastAPI, Request
+
+from app.repository import InMemoryItemRepository
+from app.schemas import Item
+
+
+def get_repository(request: Request) -> InMemoryItemRepository:
+    """从应用生命周期状态注入库存仓储依赖。"""
+    return request.app.state.item_repository
+
+
+@asynccontextmanager
+async def lifespan(app: FastAPI) -> AsyncIterator[None]:
+    """在应用启动时建立内存仓储，关闭时随应用状态释放。"""
+    app.state.item_repository = InMemoryItemRepository()
+    yield
+
+
+def create_app() -> FastAPI:
+    """构造 FastAPI 应用并注册路由。"""
+    app = FastAPI(title="inventory-svc", version="0.1.0", lifespan=lifespan)
+
+    @app.get("/items", response_model=list[Item], summary="列出库存")
+    def list_items(repository: InMemoryItemRepository = Depends(get_repository)) -> list[Item]:
+        """返回内存中的全部库存条目。"""
+        return repository.list_items()
+
+    return app
+
+
+app = create_app()
