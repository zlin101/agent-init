@@ -0,0 +1,11 @@
+"""库存条目的响应模型。"""
+
+from pydantic import BaseModel, Field
+
+
+class Item(BaseModel):
+    """库存列表中的单个条目。"""
+
+    id: int = Field(..., description="库存条目唯一标识", examples=[1])
+    name: str = Field(..., description="库存条目名称", examples=["USB-C 数据线"])
+    quantity: int = Field(..., description="当前在库数量", examples=[42])
