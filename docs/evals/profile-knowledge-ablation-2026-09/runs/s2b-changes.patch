+++ b/app/repository.py
@@ -0,0 +1,23 @@
+"""内存库存仓储。"""
+
+from app.schemas import Item
+
+
+def _seed_items() -> list[Item]:
+    """返回用于启动的示例库存数据。"""
+    return [
+        Item(id=1, name="USB-C 数据线", quantity=42),
+        Item(id=2, name="机械键盘", quantity=17),
+        Item(id=3, name="27 寸显示器", quantity=5),
+    ]
+
+
+class InMemoryItemRepository:
+    """以内存列表保存库存条目的仓储，进程内有效。"""
+
+    def __init__(self, items: list[Item] | None = None) -> None:
+        self._items: list[Item] = list(items) if items is not None else _seed_items()
+
+    def list_items(self) -> list[Item]:
+        """返回全部库存条目。"""
+        return list(self._items)
