+}
+
+func TestPollerStopTimesOutWhilePollBlocks(t *testing.T) {
+	entered := make(chan struct{}, 1)
+	release := make(chan struct{})
+	p := New(time.Millisecond, func() error {
+		select {
+		case entered <- struct{}{}:
+		default:
+		}
+		<-release
+		return nil
+	}, func(error) {})
+	if err := p.Start(); err != nil {
+		t.Fatalf("Start: %v", err)
+	}
+	select {
+	case <-entered:
+	case <-time.After(2 * time.Second):
+		t.Fatal("poll never started")
+	}
+
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Millisecond)
+	defer cancel()
+	if err := p.Stop(ctx); !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("Stop with blocked poll = %v, want context deadline error", err)
+	}
+
+	close(release)
+	stopPoller(t, p)
+	select {
+	case <-p.done:
+	default:
+		t.Fatal("polling goroutine still running after Stop")
 	}
 }
