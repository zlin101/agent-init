 package poller
 
 import (
+	"context"
+	"errors"
+	"runtime"
+	"sync/atomic"
 	"testing"
 	"time"
 )
 
+var errPoll = errors.New("poll failed")
+
+// waitFor polls cond until it holds or the deadline passes.
+func waitFor(t *testing.T, cond func() bool, msg string) {
+	t.Helper()
+	deadline := time.Now().Add(2 * time.Second)
+	for time.Now().Before(deadline) {
+		if cond() {
+			return
+		}
+		time.Sleep(time.Millisecond)
+	}
+	t.Fatal(msg)
+}
+
+// stopPoller stops p with a deadline, failing the test on error.
+func stopPoller(t *testing.T, p *Poller) {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	if err := p.Stop(ctx); err != nil {
+		t.Errorf("Stop: %v", err)
+	}
+}
+
 func TestPollerRuns(t *testing.T) {
-	polls := 0
-	p := New(10*time.Millisecond, func() error {
-		polls++
+	var polls atomic.Int64
+	p := New(5*time.Millisecond, func() error {
+		polls.Add(1)
+		return nil
+	}, func(error) {})
+	if err := p.Start(); err != nil {
+		t.Fatalf("Start: %v", err)
+	}
+	t.Cleanup(func() { stopPoller(t, p) })
+	waitFor(t, func() bool { return polls.Load() > 0 }, "poller never ran")
+}
+
+func TestPollerStopEndsPollingAndGoroutine(t *testing.T) {
+	goroutines := runtime.NumGoroutine()
+	var polls atomic.Int64
+	p := New(time.Millisecond, func() error {
+		polls.Add(1)
+		return nil
+	}, func(error) {})
+	if err := p.Start(); err != nil {
+		t.Fatalf("Start: %v", err)
+	}
+	waitFor(t, func() bool { return polls.Load() > 0 }, "poller never ran")
+
+	stopPoller(t, p)
+
+	select {
+	case <-p.done:
+	default:
+		t.Fatal("polling goroutine still running after Stop")
+	}
+	if err := p.Stop(context.Background()); err != nil {
+		t.Fatalf("second Stop: %v", err)
+	}
+
+	stopped := polls.Load()
+	time.Sleep(20 * time.Millisecond)
+	if got := polls.Load(); got != stopped {
+		t.Fatalf("poller kept polling after Stop: %d -> %d", stopped, got)
+	}
+	waitFor(t, func() bool { return runtime.NumGoroutine() <= goroutines },
+		"polling goroutine leaked after Stop")
+}
+
+func TestPollerRestartAfterStop(t *testing.T) {
+	var polls atomic.Int64
+	p := New(time.Millisecond, func() error {
+		polls.Add(1)
 		return nil
+	}, func(error) {})
+	if err := p.Start(); err != nil {
+		t.Fatalf("Start: %v", err)
+	}
+	stopPoller(t, p)
+
+	if err := p.Start(); err != nil {
+		t.Fatalf("restart Start: %v", err)
+	}
+	t.Cleanup(func() { stopPoller(t, p) })
+	waitFor(t, func() bool { return polls.Load() > 0 }, "restarted poller never ran")
+}
+
+func TestPollerStartTwice(t *testing.T) {
+	p := New(time.Hour, func() error { return nil }, func(error) {})
+	if err := p.Start(); err != nil {
