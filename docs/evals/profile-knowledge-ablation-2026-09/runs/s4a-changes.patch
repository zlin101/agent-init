+// Start begins polling in the background. It reports ErrAlreadyStarted when
+// the poller is already running, and can be called again after Stop.
+func (p *Poller) Start() error {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.running {
+		return ErrAlreadyStarted
+	}
+	stop := make(chan struct{})
+	done := make(chan struct{})
+	p.running = true
+	p.done = done
+	p.stopOnce = sync.OnceFunc(func() { close(stop) })
+	go p.run(stop, done)
+	return nil
+}
+
+// Stop stops polling and waits for the polling goroutine to exit, so a nil
+// return means fn will not be called again. It is a no-op on a poller that is
+// not running. If the goroutine has not exited when ctx is done, Stop returns
+// ctx's error wrapped and a later Stop can wait again.
+func (p *Poller) Stop(ctx context.Context) error {
+	p.mu.Lock()
+	if !p.running {
+		p.mu.Unlock()
+		return nil
+	}
+	stopOnce, done := p.stopOnce, p.done
+	p.mu.Unlock()
+
+	stopOnce()
+	select {
+	case <-done:
+		p.mu.Lock()
+		// Only the Stop that belongs to this run may clear the state, in
+		// case another goroutine restarted the poller meanwhile.
+		if p.done == done {
+			p.running = false
+		}
+		p.mu.Unlock()
+		return nil
+	case <-ctx.Done():
+		return fmt.Errorf("stop poller: %w", ctx.Err())
+	}
 }
 
