+// ErrAlreadyStarted is reported by Start when the poller is already running.
+var ErrAlreadyStarted = errors.New("poller: already started")
 
 // Poller calls fn on a fixed interval.
+//
+// The owner that calls Start owns the background goroutine and must call
+// Stop to release it; Stop returning nil guarantees the goroutine has exited.
 type Poller struct {
 	interval time.Duration
 	fn       func() error
-	ticker   *time.Ticker
