+	mu       sync.Mutex
+	running  bool
+	done     chan struct{}
+	stopOnce func()
+}
+
+// New creates a Poller that calls fn every interval and reports every error
+// fn returns to onError, so failures are never dropped. A nil onError means
+// errors are logged with the default slog logger.
+func New(interval time.Duration, fn func() error, onError func(error)) *Poller {
+	if onError == nil {
+		onError = func(err error) {
+			slog.Error("poller: poll failed", "error", err)
+		}
+	}
+	return &Poller{interval: interval, fn: fn, onError: onError}
 }
 
-// New creates a Poller.
-func New(interval time.Duration, fn func() error) *Poller {
