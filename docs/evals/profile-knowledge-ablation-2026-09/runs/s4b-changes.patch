 package poller
 
 import (
+	"errors"
+	"sync/atomic"
 	"testing"
 	"time"
 )
 
 func TestPollerRuns(t *testing.T) {
-	polls := 0
+	var polls atomic.Int64
 	p := New(10*time.Millisecond, func() error {
-		polls++
+		polls.Add(1)
 		return nil
-	})
-	p.Start()
-	time.Sleep(35 * time.Millisecond)
-	if polls == 0 {
-		t.Fatal("poller never ran")
+	}, nil)
+	if err := p.Start(); err != nil {
+		t.Fatalf("Start: %v", err)
+	}
+	t.Cleanup(p.Stop)
+
+	waitFor(t, "first poll", func() bool { return polls.Load() > 0 })
+}
+
+// TestPollerStop covers the server-shutdown path: after Stop returns the
+// polling goroutine is gone, no further polls happen, a second Start is
+// refused while running, and Stop is safe to repeat.
+func TestPollerStop(t *testing.T) {
+	var polls atomic.Int64
+	p := New(5*time.Millisecond, func() error {
+		polls.Add(1)
+		return nil
+	}, nil)
+	if err := p.Start(); err != nil {
+		t.Fatalf("Start: %v", err)
+	}
+	if err := p.Start(); err == nil {
+		t.Fatal("second Start succeeded, want error")
+	}
+
+	waitFor(t, "first poll", func() bool { return polls.Load() > 0 })
+
+	p.Stop()
+	frozen := polls.Load()
+
+	// Ten intervals with no poller running must not advance the counter.
+	time.Sleep(50 * time.Millisecond)
+	if got := polls.Load(); got != frozen {
+		t.Fatalf("polls advanced after Stop: %d -> %d", frozen, got)
+	}
+
+	p.Stop() // idempotent
+	if got := polls.Load(); got != frozen {
+		t.Fatalf("polls advanced after second Stop: %d -> %d", frozen, got)
+	}
+}
+
+// TestPollerStopWaitsForInFlightPoll verifies Stop does not return while fn
+// is still running, so the server never leaks the polling goroutine.
+func TestPollerStopWaitsForInFlightPoll(t *testing.T) {
+	entered := make(chan struct{}, 1)
+	release := make(chan struct{})
+	p := New(time.Millisecond, func() error {
+		select {
+		case entered <- struct{}{}:
+		default:
+		}
+		<-release
+		return nil
+	}, nil)
+	if err := p.Start(); err != nil {
+		t.Fatalf("Start: %v", err)
+	}
+	select {
+	case <-entered:
+	case <-time.After(time.Second):
+		t.Fatal("poll never started")
+	}
+
+	stopped := make(chan struct{})
+	go func() {
+		p.Stop()
+		close(stopped)
+	}()
+
+	select {
+	case <-stopped:
+		t.Fatal("Stop returned while a poll was still running")
+	case <-time.After(20 * time.Millisecond):
+	}
+
+	close(release)
+	select {
+	case <-stopped:
+	case <-time.After(time.Second):
+		t.Fatal("Stop did not return after the in-flight poll finished")
+	}
+}
+
+// TestPollerReportsPollError verifies fn errors reach the error handler
+// instead of being discarded, keeping the error chain intact.
+func TestPollerReportsPollError(t *testing.T) {
+	sentinel := errors.New("boom")
+	errCh := make(chan error, 1)
+	p := New(5*time.Millisecond, func() error { return sentinel },
+		func(err error) {
+			select {
+			case errCh <- err:
+			default:
+			}
+		})
+	if err := p.Start(); err != nil {
+		t.Fatalf("Start: %v", err)
+	}
+	t.Cleanup(p.Stop)
+
+	select {
+	case err := <-errCh:
+		if !errors.Is(err, sentinel) {
+			t.Fatalf("error = %v, want it to wrap %v", err, sentinel)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("poll error was never reported")
+	}
+}
+
+func TestPollerStartRejectsInvalidConfig(t *testing.T) {
+	cases := []struct {
+		name string
+		p    *Poller
+	}{
+		{"non-positive interval", New(0, func() error { return nil }, nil)},
+		{"nil poll function", New(time.Millisecond, nil, nil)},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			if err := tc.p.Start(); err == nil {
+				t.Fatal("Start succeeded, want error")
+			}
+		})
+	}
+}
+
+func waitFor(t *testing.T, what string, cond func() bool) {
+	t.Helper()
+	deadline := time.Now().Add(2 * time.Second)
+	for !cond() {
+		if time.Now().After(deadline) {
+			t.Fatalf("timed out waiting for %s", what)
+		}
+		time.Sleep(time.Millisecond)
 	}
 }
