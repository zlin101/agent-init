 // Package poller runs a periodic background poll.
 package poller
 
-import "time"
+import (
+	"errors"
+	"fmt"
+	"log/slog"
+	"sync"
+	"time"
+)
 
-// Poller calls fn on a fixed interval.
+// Poller calls fn on a fixed interval. It is meant to be owned by a server
+// lifecycle: Start launches one background goroutine and Stop terminates it,
+// waiting for a poll already in flight so the goroutine does not outlive the
+// server.
 type Poller struct {
 	interval time.Duration
 	fn       func() error
-	ticker   *time.Ticker
+	onError  func(error)
+
+	mu     sync.Mutex
+	stopCh chan struct{} // closed to request shutdown; nil while not running
+	doneCh chan struct{} // closed when the polling goroutine has exited
 }
 
-// New creates a Poller.
-func New(interval time.Duration, fn func() error) *Poller {
-	return &Poller{interval: interval, fn: fn}
+// New creates a Poller that runs fn on every tick. Each non-nil error from fn
+// is reported once to onError; when onError is nil the error is logged with
+// slog, so poll errors are never dropped silently.
+func New(interval time.Duration, fn func() error, onError func(error)) *Poller {
+	return &Poller{interval: interval, fn: fn, onError: onError}
 }
 
-// Start begins polling in the background.
-func (p *Poller) Start() {
-	p.ticker = time.NewTicker(p.interval)
+// Start launches the polling goroutine. It returns an error if the poller is
+// already running or its interval or fn is unusable, instead of panicking.
+// Start may be called again after Stop.
+func (p *Poller) Start() error {
+	if p.interval <= 0 {
+		return fmt.Errorf("poller: interval must be positive, got %s", p.interval)
+	}
+	if p.fn == nil {
+		return errors.New("poller: nil poll function")
+	}
+
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.stopCh != nil {
+		return errors.New("poller: already started")
+	}
+
+	stopCh := make(chan struct{})
+	doneCh := make(chan struct{})
+	p.stopCh, p.doneCh = stopCh, doneCh
+
+	ticker := time.NewTicker(p.interval)
 	go func() {
-		for range p.ticker.C {
-			_ = p.fn()
+		defer close(doneCh)
+		defer ticker.Stop()
+		for {
+			select {
+			case <-stopCh:
+				return
+			case <-ticker.C:
+				if err := p.fn(); err != nil {
+					p.report(fmt.Errorf("poll: %w", err))
+				}
+			}
 		}
 	}()
+	return nil
+}
+
+// Stop requests shutdown and blocks until the polling goroutine has exited,
+// including any poll already in flight. It is a no-op while the poller is not
+// running, so the server can defer it unconditionally.
+func (p *Poller) Stop() {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.stopCh == nil {
+		return
+	}
+	close(p.stopCh)
+	<-p.doneCh
+	p.stopCh, p.doneCh = nil, nil
+}
+
+// report delivers a poll error to the handler given to New, falling back to
+// the standard logger when no handler was provided.
+func (p *Poller) report(err error) {
+	if p.onError != nil {
+		p.onError(err)
+		return
+	}
+	slog.Error("poller: poll failed", "error", err)
 }
