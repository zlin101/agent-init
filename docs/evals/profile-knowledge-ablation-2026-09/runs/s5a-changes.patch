+# pyright: reportMissingImports=false
+"""Pydantic models for the catalog API's public responses."""
+
+from typing import Generic, TypeVar
+
+from pydantic import BaseModel, Field
+
+T = TypeVar("T")
+
+
+class Book(BaseModel):
+    """A single book entry as exposed by the catalog API."""
+
+    id: int = Field(..., description="Stable book identifier", examples=[1])
+    title: str = Field(..., description="Book title", examples=["The Left Hand of Darkness"])
+    author: str = Field(..., description="Primary author name", examples=["Ursula Le Guin"])
+
+
+class PaginatedResponse(BaseModel, Generic[T]):
+    """Envelope returned by paginated list endpoints.
+
+    `page` and `page_size` echo the effective request parameters and
+    `total` reports the item count across all pages, so callers can page
+    through results without tracking server-side state.
+    """
+
+    items: list[T] = Field(..., description="Items belonging to the requested page")
+    total: int = Field(..., description="Total number of items across all pages")
+    page: int = Field(..., description="Effective 1-based page number")
+    page_size: int = Field(..., description="Effective number of items per page")
