+@app.get("/books", response_model=PaginatedResponse[Book])
+def list_books(
+    page: int = Query(default=1, ge=1, description="1-based page number; defaults to 1."),
+    page_size: int = Query(
+        default=20,
+        ge=1,
+        le=100,
+        description="Items per page; defaults to 20, maximum 100.",
+    ),
+) -> PaginatedResponse[Book]:
+    """Return one page of the book catalog, ordered by book id.
+
+    Pagination is 1-based. `page < 1` or `page_size` outside 1..100 are
+    rejected with HTTP 422 by request validation before this handler runs. A
+    `page` past the end of the catalog returns an empty `items` list while
+    `total` still reports the full catalog size.
+    """
+    total = len(BOOKS)
+    start = (page - 1) * page_size
+    return PaginatedResponse[Book](
+        items=list(BOOKS[start : start + page_size]),
+        total=total,
+        page=page,
+        page_size=page_size,
+    )
