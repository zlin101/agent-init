+# pyright: reportMissingImports=false
+"""Tests for the GET /books endpoint."""
+
+import asyncio
+
+import httpx
+
+from app.main import app
+
+
+def fetch(path: str, params: dict[str, int] | None = None) -> httpx.Response:
+    """Send a GET request through the ASGI app in-process, without a real socket."""
+
+    async def run() -> httpx.Response:
+        transport = httpx.ASGITransport(app=app)
+        async with httpx.AsyncClient(transport=transport, base_url="http://test") as client:
+            return await client.get(path, params=params)
+
+    return asyncio.run(run())
+
+
+def test_list_books_default_pagination() -> None:
+    """Defaults are page=1 and page_size=20, and the body matches the Pydantic envelope."""
+    resp = fetch("/books")
+    assert resp.status_code == 200
+
+    body = resp.json()
+    assert set(body) == {"items", "total", "page", "page_size"}
+    assert body["page"] == 1
+    assert body["page_size"] == 20
+    assert 1 <= len(body["items"]) <= body["page_size"]
+    assert body["total"] >= len(body["items"])
+    assert set(body["items"][0]) == {"id", "title", "author"}
+
+
+def test_list_books_pages_slice_the_same_ordering() -> None:
+    """Page N contains exactly the Nth window of the id-ordered catalog."""
+    everything = fetch("/books", {"page_size": 100}).json()
+    all_ids = [book["id"] for book in everything["items"]]
+
+    second_page = fetch("/books", {"page": 2, "page_size": 2}).json()
+    assert [book["id"] for book in second_page["items"]] == all_ids[2:4]
+    assert second_page["page"] == 2
+    assert second_page["page_size"] == 2
+    assert second_page["total"] == everything["total"]
+
+
+def test_list_books_page_past_end_is_empty() -> None:
+    """An out-of-range page is not an error: items are empty but total stays accurate."""
+    resp = fetch("/books", {"page": 99, "page_size": 5})
+    assert resp.status_code == 200
+
+    body = resp.json()
+    assert body["items"] == []
+    assert body["page"] == 99
+    assert body["total"] >= 1
+
+
+def test_list_books_enforces_page_size_upper_limit() -> None:
+    """page_size=100 is allowed; anything above the documented cap is rejected."""
+    assert fetch("/books", {"page_size": 100}).status_code == 200
+    assert fetch("/books", {"page_size": 101}).status_code == 422
+
+
+def test_list_books_rejects_page_below_one() -> None:
+    """Pages are 1-based, so page=0 fails validation instead of silently shifting results."""
+    assert fetch("/books", {"page": 0}).status_code == 422
