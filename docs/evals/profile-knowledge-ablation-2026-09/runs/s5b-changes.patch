+# pyright: reportMissingImports=false
+"""Pydantic response models shared by the catalog API."""
+
+from typing import Generic, TypeVar
+
+from pydantic import BaseModel, Field
+
+# Element type of a page: FastAPI renders Page[Book] as a concrete schema in the
+# generated OpenAPI document, so callers see the real item shape instead of a
+# generic placeholder.
+ItemT = TypeVar("ItemT")
+
+
+class Book(BaseModel):
+    """A single catalog entry as returned by the books endpoints."""
+
+    id: int = Field(description="Stable identifier of the book.", examples=[1])
+    title: str = Field(description="Book title.", examples=["A Wizard of Earthsea"])
+    author: str = Field(description="Display name of the author.", examples=["Ursula Le Guin"])
+
+
+class Page(BaseModel, Generic[ItemT]):
+    """Paginated collection envelope shared by list endpoints.
+
+    Every paginated endpoint returns this shape so callers can read ``total``
+    and ``page`` uniformly instead of parsing per-endpoint structures.
+    """
+
+    items: list[ItemT] = Field(description="Entries belonging to the requested page.")
+    total: int = Field(
+        description="Number of entries across all pages, independent of the requested page.",
+        examples=[42],
+    )
+    page: int = Field(description="1-based number of the page being returned.", examples=[1])
+    page_size: int = Field(
+        description="Requested number of entries per page; capped at 100.",
+        examples=[20],
+    )
