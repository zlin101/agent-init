+# pyright: reportMissingImports=false
+"""Tests for the paginated GET /books endpoint."""
+
+import asyncio
+
+import httpx
+
+from app.main import app
+from app.schemas import Book, Page
+
+
+def _get(path: str, params: dict[str, object] | None = None) -> httpx.Response:
+    async def run() -> httpx.Response:
+        transport = httpx.ASGITransport(app=app)
+        async with httpx.AsyncClient(transport=transport, base_url="http://test") as client:
+            return await client.get(path, params=params)
+
+    return asyncio.run(run())
+
+
+def test_list_books_defaults_to_first_page_of_twenty():
+    resp = _get("/books")
+    assert resp.status_code == 200
+
+    # The payload must be exactly the Pydantic Page[Book] contract, not an
+    # accidental dict shape from the route.
+    page = Page[Book].model_validate(resp.json())
+    assert page.page == 1
+    assert page.page_size == 20
+    assert page.total == 10
+    assert len(page.items) == 10
+    assert page.items[0] == Book(id=1, title="A Wizard of Earthsea", author="Ursula Le Guin")
+
+
+def test_list_books_returns_requested_slice():
+    resp = _get("/books", {"page": 2, "page_size": 4})
+    assert resp.status_code == 200
+
+    body = resp.json()
+    assert body["page"] == 2
+    assert body["page_size"] == 4
+    assert body["total"] == 10
+    assert [item["id"] for item in body["items"]] == [5, 6, 7, 8]
+
+
+def test_list_books_last_page_can_be_partial():
+    resp = _get("/books", {"page": 3, "page_size": 4})
+    assert resp.status_code == 200
+
+    body = resp.json()
+    assert [item["id"] for item in body["items"]] == [9, 10]
+    assert body["total"] == 10
+
+
+def test_list_books_page_past_end_is_empty_but_keeps_total():
+    resp = _get("/books", {"page": 99, "page_size": 5})
+    assert resp.status_code == 200
+
+    body = resp.json()
+    assert body["items"] == []
+    assert body["total"] == 10
+    assert body["page"] == 99
+
+
+def test_list_books_accepts_page_size_up_to_limit():
+    resp = _get("/books", {"page_size": 100})
+    assert resp.status_code == 200
+    assert resp.json()["page_size"] == 100
+
+
+def test_list_books_rejects_page_size_above_limit():
+    resp = _get("/books", {"page_size": 101})
+    assert resp.status_code == 422
+
+
+def test_list_books_rejects_non_positive_page():
+    assert _get("/books", {"page": 0}).status_code == 422
+    assert _get("/books", {"page_size": 0}).status_code == 422
+
+
+def test_books_response_models_are_published_in_openapi():
+    schemas = app.openapi()["components"]["schemas"]
+    assert "Book" in schemas
+    # The generic envelope materialises as a concrete schema such as Page_Book.
+    assert any(name.startswith("Page") for name in schemas)
