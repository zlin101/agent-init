+@app.get("/books", response_model=Page[Book])
+def list_books(
+    page: int = Query(default=1, ge=1, description="1-based page number; must be at least 1."),
+    page_size: int = Query(
+        default=20,
+        ge=1,
+        le=100,
+        description="Entries per page, 1-100. Larger values are rejected with HTTP 422.",
+    ),
+) -> Page[Book]:
+    """Return one page of the book catalog ordered by book id.
+
+    ``page`` counts from 1 and ``page_size`` defaults to 20 with a hard limit of
+    100: out-of-range parameter values fail validation with HTTP 422 instead of
+    being clamped. A page past the end of the catalog yields an empty ``items``
+    list while ``total`` still reports the full catalog size.
+    """
+    # Catalog is static and ordered by id, so slicing is enough to pick the page;
+    # an offset past the end simply yields an empty slice.
+    offset = (page - 1) * page_size
+    end = offset + page_size
+    return Page[Book](
+        items=list(BOOKS[offset:end]),
+        total=len(BOOKS),
+        page=page,
+        page_size=page_size,
+    )
